# 河北工业大学本科报考咨询环境变量配置示例
# 复制此文件为 .env 并填写实际值

# ── 应用 ──────────────────────────────────────────────────────────────────────
APP_NAME=HebutAdmissions
APP_ENV=production
LOG_LEVEL=INFO

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Anthropic Claude ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 可选：覆盖为兼容 Anthropic 协议的第三方 API（如 DeepSeek）
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# 可选：覆盖模型名称（默认 claude-3-5-sonnet-20241022）
# 使用 DeepSeek 时设为 deepseek-chat
# ANTHROPIC_MODEL=deepseek-chat

# DeepSeek Anthropic 兼容接口默认为思考模式；咨询、路由和 JSON 提取建议关闭
DEEPSEEK_THINKING_MODE=disabled

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=hellohebut123

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=./data/chroma
KNOWLEDGE_COLLECTION=hello_hebut
# 启动时自动扫描并增量导入 txt/md/json；留空可关闭
KNOWLEDGE_SEED_DIR=./data/demo_docs
# LLM 重排相关性采用 0-10 分，低于该值的知识片段不会进入回答上下文
RAG_RERANK_MIN_SCORE=5.0
# 词法：filtered_legacy（默认，旧评分去除过滤年份）/ bm25（对照候选）/ legacy（原始评分）
RAG_LEXICAL_MODE=filtered_legacy
# 融合：balanced（等权 RRF，默认）/ legacy（原 0.6/0.4 加权与保底）
RAG_FUSION_MODE=balanced

# 河北、天津2023—2025年分专业最低分和最低位次长表
ADMISSION_DATA_PATH=./data/hebut_admission.csv

# ── 监控 ──────────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=9091
ANOMALY_DETECTION_THRESHOLD=2.0

# ── 评测 ──────────────────────────────────────────────────────────────────────
EVAL_BASELINE_PATH=./data/eval/baseline.json
# 可选：使用与回答模型不同的 Judge，未配置时沿用 ANTHROPIC_MODEL
# EVAL_JUDGE_MODEL=your_judge_model

# ── Skills ───────────────────────────────────────────────────────────────────
# 默认读取项目内 ./skills，支持运行时通过 POST /skills/reload 热加载
HELLOHEBUT_SKILLS_DIR=./skills
HELLOHEBUT_SKILLS_MAX_PROMPT_CHARS=5000

# ── 安全 ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_in_production
JWT_SECRET_KEY=change_this_in_production
# 未配置时关闭管理接口；配置后知识写入/回退、Skills 重载和评测要求 X-Admin-Token
ADMIN_API_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── 功能开关 ──────────────────────────────────────────────────────────────────
ENABLE_SWAGGER_UI=true
ENABLE_MONITORING=true
ENABLE_EVALUATION=true

# v2：独立运行数据，聊天会话先通过 POST /session 获取令牌
HELLOHEBUT_AGENTIC_RAG=true
V2_CHAT_TIMEOUT_S=50
V2_KNOWLEDGE_COLLECTION=hello_hebut_v2
V2_TRACE_DIR=./experiments/v2/traces/chat
V2_EVAL_BASELINE_PATH=./experiments/v2/reports/live/baseline.json
V2_FRONTEND_PORT=8088
V2_API_PORT=18000

# v2 工作流/协作：默认单角色，复杂协作与模型只读工具循环可独立对照
HELLOHEBUT_CHAT_GRAPH=true
HELLOHEBUT_ROLE_MODE=single
HELLOHEBUT_TOOL_LOOP=false
HELLOHEBUT_CONTEXT_MAX_INPUT_TOKENS=8000
V2_WORKERS=2
# 可选的 Langfuse OTLP/HTTP 元数据导出；三项齐全才启用，不上传问题/答案/身份
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# 可选，按模型合同填写每百万 token 单价；留空时不估算费用
V2_INPUT_PRICE_PER_MILLION=
V2_OUTPUT_PRICE_PER_MILLION=
V2_PRICE_CURRENCY=CNY

# v2 MySQL 8.4：确认偏好、版本与持久聊天账本
HELLOHEBUT_VERIFIED_MEMORY=true
V2_MYSQL_PORT=15433
V2_MYSQL_PASSWORD=hellohebut123
V2_MYSQL_ROOT_PASSWORD=hellohebut-root-local
# Docker Hub 加速源异常时可使用 Docker 官方镜像的 ECR Public 分发入口
# V2_MYSQL_IMAGE=public.ecr.aws/docker/library/mysql:8.4
# 宿主机直跑时使用 MYSQL_*；Compose 自动覆盖容器内地址
MYSQL_HOST=localhost
MYSQL_PORT=15433
MYSQL_DATABASE=hellohebut
MYSQL_USER=hellohebut
MYSQL_PASSWORD=hellohebut123
# 可选：完整连接串，优先于 MYSQL_*；只接受 mysql/mysql+asyncmy 协议
# V2_FACT_DATABASE_URL=mysql://user:password@host:3306/database
